{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MicroSim Metadata Schema v1 (legacy)",
    "description": "Legacy v1 schema kept for reference only. New metadata should use microsim-schema.json.",
    "type": "object",
    "properties": {
      "MicroSim": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "SubjectArea": {
            "type": "string"
          },
          "Topic": {
            "type": "string"
          },
          "Parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Label": {"type": "string"},
                "Min": {"type": "number"},
                "Max": {"type": "number"},
                "Default": {"type": "number"},
                "Increment": {"type": "number"}
              },
              "required": ["Label", "Min", "Max", "Default", "Increment"]
            }
          },
          "GradeLevel": {
            "type": "string"
          },
          "LessonPlans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Title": {"type": "string"},
                "Description": {"type": "string"}
              },
              "required": ["Title", "Description"]
            }
          }
        },
        "required": ["Name", "Description", "SubjectArea", "Topic", "Parameters", "GradeLevel"]
      }
    },
    "required": ["MicroSim"]
  }
  