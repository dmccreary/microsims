  "metricDescriptions": {
    "personalIncome": {
      "name": "Personal Income",
      "description": "Real per capita personal income, adjusted for regional price parities and inflation (chained 2017 dollars)",
      "unit": "$",
      "source": "Bureau of Economic Analysis, Real Personal Income for States (2023)"
    },
    "povertyRate": {
      "name": "Poverty Rate",
      "description": "Percentage of people in poverty under the Supplemental Poverty Measure, which adjusts for regional housing costs (3-year average, 2023-2025)",
      "unit": "%",
      "source": "US Census Bureau, Poverty in the United States: 2025, Table 17"
    },
    "educationAttainment": {
      "name": "Education Attainment",
      "description": "Percentage of adults 25+ with bachelor's degree or higher",
      "unit": "%",
      "source": "US Census Bureau, American Community Survey 1-year estimates (2023)"
    },
    "lifeExpectancy": {
      "name": "Life Expectancy",
      "description": "Average life expectancy at birth in years",
      "unit": " years",
      "source": "CDC National Center for Health Statistics, U.S. State Life Tables (2022)"
    },
    "infantMortality": {
      "name": "Infant Mortality",
      "description": "Infant deaths per 1,000 live births",
      "unit": " per 1,000",
      "source": "CDC National Center for Health Statistics (2023)"
    },
    "violentCrime": {
      "name": "Violent Crime Rate",
      "description": "Violent crimes per 100,000 population",
      "unit": " per 100,000",
      "source": "FBI Uniform Crime Reporting Program, estimated crimes (2023)"
    },
    "medianHomePrice": {
      "name": "Median Home Price",
      "description": "Typical home value: Zillow Home Value Index for all homes, average of the 12 months of 2024",
      "unit": "$",
      "source": "Zillow Home Value Index (2024)"
    },
    "foodInsecurity": {
      "name": "Food Insecurity",
      "description": "Percentage of households experiencing food insecurity (3-year average, 2021-2023)",
      "unit": "%",
      "source": "USDA Economic Research Service, Household Food Security in the United States in 2023"
    }
  },
